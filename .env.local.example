# ==============================================================================
# The Sacred Shelf — Environment Variables Template
# Copy this file to .env.local and fill in the values before running the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ONLY used on the server (API routes/Server Components). Never expose to the browser!
# Required for bypassing RLS to insert tracking data and fetch full lists securely.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# GOOGLE ADSENSE
# ------------------------------------------------------------------------------
# Your Publisher ID (e.g., ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""

# Optional specific ad slot ID for the reader page top banner
NEXT_PUBLIC_ADSENSE_SLOT_READER=""

# ------------------------------------------------------------------------------
# GOOGLE ANALYTICS 4 (ADMIN DASHBOARD API)
# ------------------------------------------------------------------------------
# Your GA4 Property ID (found in Admin -> Property Settings)
GA4_PROPERTY_ID=""

# Stringified JSON of your Google Cloud Service Account key. 
# Used by the backend to fetch demographic data securely.
GA4_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "..."}'
